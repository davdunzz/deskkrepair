<Window x:Class="RepairDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RepairDesk" Icon="Assets/RepairDesk.ico" Height="900" Width="1360" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource MainGradient}" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="#7FA7E8" BorderThickness="0,0,1,0" Padding="18,24">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><StackPanel Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="13" Background="#171A24" Padding="5"><Image Source="Assets/RepairDesk.png" Stretch="Uniform"/></Border><StackPanel Margin="12,4,0,0"><TextBlock Text="RepairDesk" Foreground="White" FontSize="19" FontWeight="Bold"/><TextBlock Text="SERVICE SUITE" Foreground="#F6C945" FontSize="9" FontWeight="Bold"/></StackPanel></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,34,0,0">
          <TextBlock Text="WORKSPACE" Foreground="#DCEAFF" FontSize="10" FontWeight="Bold" Margin="12,0,0,9"/>
          <Button x:Name="NavDashboardButton" Style="{StaticResource SidebarButton}" Click="NavDashboard_Click"><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" CornerRadius="8" Background="#252938"><TextBlock Text="⌂" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Dashboard" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
          <Button x:Name="NavNewButton" Style="{StaticResource SidebarButton}" Click="NavNewRepair_Click"><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" CornerRadius="8" Background="#252938"><TextBlock Text="＋" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Nuova riparazione" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
          <Button x:Name="NavInventoryButton" Style="{StaticResource SidebarButton}" Click="NavInventory_Click"><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" CornerRadius="8" Background="#252938"><TextBlock Text="▣" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Magazzino" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
          <Button x:Name="NavArchiveButton" Style="{StaticResource SidebarButton}" Click="NavArchive_Click"><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" CornerRadius="8" Background="#252938"><TextBlock Text="▤" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Archivio" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
          <Button x:Name="NavCalendarButton" Style="{StaticResource SidebarButton}" Click="NavCalendar_Click"><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" CornerRadius="8" Background="#252938"><TextBlock Text="▦" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Calendario" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
          <Button x:Name="NavManualsButton" Style="{StaticResource SidebarButton}" Click="NavManuals_Click"><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" CornerRadius="8" Background="#252938"><TextBlock Text="▧" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Manuali tecnici" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
          <Button x:Name="NavCatalogButton" Style="{StaticResource SidebarButton}" Click="NavCatalog_Click"><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" CornerRadius="8" Background="#252938"><TextBlock Text="◇" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Catalogo telefoni" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
          <Button x:Name="NavSettingsButton" Style="{StaticResource SidebarButton}" Click="NavSettings_Click"><StackPanel Orientation="Horizontal"><Border Width="31" Height="31" CornerRadius="8" Background="#252938"><TextBlock Text="⚙" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Impostazioni" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
        </StackPanel>
        <Border Grid.Row="2" Background="#171A22" BorderBrush="#282C37" BorderThickness="1" CornerRadius="12" Padding="13"><StackPanel><TextBlock Text="●  SISTEMA ATTIVO" Foreground="#55D99A" FontWeight="Bold" FontSize="10"/><TextBlock Text="Archivio locale e protetto" Foreground="#A4ACBC" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{StaticResource HeaderGradient}" Padding="30,13" BorderBrush="#E2E6ED" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left"><TextBlock Text="Centro operativo" FontSize="24" FontWeight="Bold" Foreground="#141722"/><TextBlock Text="Gestione riparazioni e magazzino" FontSize="11" Foreground="#687083"/></StackPanel>
        <Border DockPanel.Dock="Right" Background="#F1F2F6" CornerRadius="12" Padding="15,8" VerticalAlignment="Center"><TextBlock Text="●  Tutti i sistemi operativi" Foreground="#4E5668" FontWeight="SemiBold"/></Border>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="1" Margin="22,18" Background="Transparent" BorderThickness="0" x:Name="MainTabs" Style="{StaticResource SideNavigationTabs}">
      <TabItem Header="DASHBOARD">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,16"><StackPanel MaxWidth="1180">
          <TextBlock Text="Panoramica operativa" FontSize="27" FontWeight="Bold" Margin="0,0,0,16"/>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#EAF1FF" CornerRadius="14" Padding="20" Margin="0,0,10,0"><StackPanel><TextBlock Text="DA FARE" Foreground="#145EDB" FontWeight="Bold"/><TextBlock x:Name="DashboardTodoCount" Text="0" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="1" Background="#FFF0F1" CornerRadius="14" Padding="20" Margin="5,0"><StackPanel><TextBlock Text="CRITICI / URGENTI" Foreground="#C43E4D" FontWeight="Bold"/><TextBlock x:Name="DashboardCriticalCount" Text="0" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="2" Background="#FFF7D6" CornerRadius="14" Padding="20" Margin="10,0,0,0"><StackPanel><TextBlock Text="RICAMBI DA ORDINARE" Foreground="#9A6B00" FontWeight="Bold"/><TextBlock x:Name="DashboardOrderCount" Text="0" FontSize="34" FontWeight="Bold"/></StackPanel></Border>
          </Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <GroupBox Header="Prossimi appuntamenti" Margin="0,0,9,18"><ListBox x:Name="DashboardAppointmentsList" MinHeight="190" DisplayMemberPath="DashboardAppointmentText"/></GroupBox>
            <GroupBox Grid.Column="1" Header="Appuntamenti ancora da fissare" Margin="9,0,0,18"><ListBox x:Name="DashboardUnscheduledList" MinHeight="190"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/><TextBlock Text="{Binding Device}"/><TextBlock Text="{Binding RepairDescription}" Foreground="#687083" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox>
            <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Ricambi in esaurimento (quantità 1 o 2)"><DataGrid x:Name="DashboardLowStockGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="170"><DataGrid.Columns><DataGridTextColumn Header="Codice" Binding="{Binding Code}" Width="160"/><DataGridTextColumn Header="Ricambio" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="180"/><DataGridTextColumn Header="Quantità" Binding="{Binding Quantity}" Width="100"/></DataGrid.Columns></DataGrid></GroupBox>
          </Grid>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="NUOVA RIPARAZIONE">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,16">
          <StackPanel MaxWidth="1100">
            <GroupBox Header="1. Anagrafica cliente">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="Nome *"/><TextBox x:Name="FirstNameBox"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Cognome *"/><TextBox x:Name="LastNameBox"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Telefono *"/><TextBox x:Name="PhoneBox"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2"><TextBlock Text="Email"/><TextBox x:Name="EmailBox"/></StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Header="2. Smartphone">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="Marca * (se manca, scrivila)"/><ComboBox x:Name="BrandBox" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="BrandBox_SelectionChanged" LostKeyboardFocus="BrandBox_LostKeyboardFocus"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Modello * (se manca, scrivilo)"/><ComboBox x:Name="ModelBox" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Colore"/><TextBox x:Name="ColorBox"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="IMEI / seriale"/><TextBox x:Name="ImeiBox"/></StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Header="3. Appuntamento (opzionale)">
              <StackPanel Orientation="Horizontal">
                <StackPanel Width="260"><TextBlock Text="Data appuntamento"/><DatePicker x:Name="AppointmentDatePicker" Margin="0,5,12,10" Padding="8"/></StackPanel>
                <StackPanel Width="180"><TextBlock Text="Ora (es. 14:30)"/><TextBox x:Name="AppointmentTimeBox" MaxLength="5"/></StackPanel>
                <StackPanel Width="220"><TextBlock Text="Codice dipendente"/><TextBox x:Name="EmployeeCodeBox" MaxLength="30"/></StackPanel>
                <Button Content="RIMUOVI DATA" Background="#6D7588" VerticalAlignment="Bottom" Margin="4,5,4,10" Click="ClearAppointment_Click"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Stato della riparazione">
              <StackPanel><TextBlock Text="Stato iniziale"/><ComboBox x:Name="RepairStatusBox" SelectedIndex="0"><ComboBoxItem Content="DA FARE"/><ComboBoxItem Content="ORDINARE RICAMBIO"/><ComboBoxItem Content="FATTO"/><ComboBoxItem Content="CRITICO / URGENTE"/></ComboBox></StackPanel>
            </GroupBox>

            <GroupBox Header="4. Ricambi utilizzati dal magazzino">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><StackPanel Width="280"><TextBlock Text="Codice ricambio"/><TextBox x:Name="PartCodeBox"/></StackPanel><StackPanel Width="120"><TextBlock Text="Quantità"/><TextBox x:Name="PartQuantityBox" Text="1"/></StackPanel><Button Content="AGGIUNGI RICAMBIO" VerticalAlignment="Bottom" Margin="4,5,4,10" Click="AddUsedPart_Click"/></StackPanel>
                <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="RIMUOVI SELEZIONATO" Background="#C43E4D" Click="RemoveUsedPart_Click"/><ListBox x:Name="UsedPartsList" MinHeight="54" DisplayMemberPath="Display" Background="#F8F9FD" BorderBrush="#DDE3EE"/></DockPanel>
              </Grid>
            </GroupBox>

            <GroupBox Header="5. Riparazione richiesta">
              <StackPanel>
                <TextBlock Text="Descrivi esattamente il lavoro da eseguire *"/>
                <TextBox x:Name="RepairDescriptionBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Spunte rapide" FontWeight="SemiBold" Margin="0,5,0,3"/>
                <WrapPanel x:Name="RepairTypesPanel">
                  <CheckBox Content="Display"/><CheckBox Content="Batteria"/><CheckBox Content="Connettore ricarica"/><CheckBox Content="Fotocamera"/>
                  <CheckBox Content="Microfono"/><CheckBox Content="Altoparlante"/><CheckBox Content="Vetro posteriore"/><CheckBox Content="Pulsanti"/>
                  <CheckBox Content="Diagnosi"/><CheckBox Content="Recupero dati"/><CheckBox Content="Software"/><CheckBox Content="Altro"/>
                </WrapPanel>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="6. Accessori consegnati">
              <WrapPanel x:Name="AccessoriesPanel">
                <CheckBox Content="SIM"/><CheckBox Content="Cover"/><CheckBox Content="Pellicola / vetro"/><CheckBox Content="Caricatore"/>
                <CheckBox Content="Cavo USB"/><CheckBox Content="Scatola"/><CheckBox Content="Scheda di memoria"/><CheckBox Content="Custodia"/><CheckBox Content="Nessun accessorio"/>
              </WrapPanel>
            </GroupBox>

            <GroupBox Header="7. Stato del telefono alla consegna">
              <StackPanel>
                <WrapPanel x:Name="ConditionsPanel">
                  <CheckBox Content="Telefono acceso"/><CheckBox Content="Telefono spento"/><CheckBox Content="Non verificabile"/><CheckBox Content="Display rotto"/>
                  <CheckBox Content="Display graffiato"/><CheckBox Content="Scocca graffiata"/><CheckBox Content="Scocca ammaccata"/><CheckBox Content="Vetro posteriore rotto"/>
                  <CheckBox Content="Fotocamera danneggiata"/><CheckBox Content="Telefono piegato"/><CheckBox Content="Parti mancanti"/><CheckBox Content="Liquido / ossidazione"/><CheckBox Content="Blocco PIN"/>
                </WrapPanel>
                <TextBlock Text="Note sulle condizioni" Margin="0,10,0,0"/>
                <TextBox x:Name="ConditionNotesBox" Height="74" AcceptsReturn="True" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
              <Button Content="PULISCI MODULO" Background="#6D7588" Click="ClearForm_Click"/>
              <Button x:Name="SaveOnlyButton" Content="SALVA NELL'ARCHIVIO" Background="#138A72" Padding="24,12" Click="SaveOnly_Click"/>
              <Button Content="SALVA E GENERA PDF" Padding="28,12" Click="SaveAndGenerate_Click"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="MAGAZZINO">
        <Grid Margin="8,16"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,18,0">
            <GroupBox Header="Inserisci / modifica ricambio"><StackPanel>
              <TextBlock Text="Codice univoco *"/><TextBox x:Name="InventoryCodeBox"/>
              <TextBlock Text="Nome ricambio *"/><TextBox x:Name="InventoryNameBox"/>
              <TextBlock Text="Categoria"/><ComboBox x:Name="InventoryCategoryBox" IsEditable="True"><ComboBoxItem Content="Batteria"/><ComboBoxItem Content="Schermo"/><ComboBoxItem Content="Connettore"/><ComboBoxItem Content="Fotocamera"/><ComboBoxItem Content="Altro"/></ComboBox>
              <TextBlock Text="Quantità in giacenza"/><TextBox x:Name="InventoryQuantityBox" Text="0"/>
              <Button x:Name="SaveInventoryButton" Content="SALVA RICAMBIO" Click="SaveInventory_Click"/>
              <Button Content="NUOVO / PULISCI" Background="#6D7588" Click="ClearInventory_Click"/>
            </StackPanel></GroupBox>
          </StackPanel>
          <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel><Button DockPanel.Dock="Right" Content="CERCA" Click="SearchInventory_Click"/><TextBox x:Name="InventorySearchBox" ToolTip="Cerca codice, nome o categoria" KeyDown="InventorySearchBox_KeyDown"/></DockPanel>
            <DataGrid Grid.Row="1" x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,10" MouseDoubleClick="InventoryGrid_MouseDoubleClick">
              <DataGrid.Columns><DataGridTextColumn Header="Codice" Binding="{Binding Code}" Width="150"/><DataGridTextColumn Header="Nome ricambio" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="150"/><DataGridTextColumn Header="Quantità" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="Stato" Binding="{Binding StockStatus}" Width="130"/></DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="MODIFICA" Background="#D18416" Click="EditInventory_Click"/><Button Content="ELIMINA" Background="#C43E4D" Click="DeleteInventory_Click"/></StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="ARCHIVIO">
        <Grid Margin="8,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><Button DockPanel.Dock="Right" Content="CERCA" Click="Search_Click"/><TextBox x:Name="SearchBox" MinWidth="450" ToolTip="Cerca nome, telefono, email, IMEI o numero pratica" KeyDown="SearchBox_KeyDown"/></DockPanel>
          <DataGrid Grid.Row="1" x:Name="ArchiveGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,10" Background="White">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Pratica" Binding="{Binding PracticeNumber}" Width="150"/>
              <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
              <DataGridTextColumn Header="Cliente" Binding="{Binding DisplayName}" Width="*"/>
              <DataGridTextColumn Header="Telefono" Binding="{Binding Phone}" Width="140"/>
              <DataGridTextColumn Header="Dispositivo" Binding="{Binding Device}" Width="*"/>
              <DataGridTextColumn Header="Appuntamento" Binding="{Binding AppointmentText}" Width="145"/>
              <DataGridTextColumn Header="Operatore" Binding="{Binding EmployeeCode}" Width="105"/>
              <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="155"/>
              <DataGridTextColumn Header="Riparazione" Binding="{Binding RepairDescription}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ComboBox x:Name="ArchiveStatusBox" Width="190" SelectedIndex="0"><ComboBoxItem Content="DA FARE"/><ComboBoxItem Content="ORDINARE RICAMBIO"/><ComboBoxItem Content="FATTO"/><ComboBoxItem Content="CRITICO / URGENTE"/></ComboBox><Button Content="APPLICA STATO" Click="ApplyArchiveStatus_Click"/></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button Content="GENERA LISTA" Background="#F5B82E" Foreground="#172033" Click="GenerateAppointmentList_Click"/><Button Content="AGGIORNA" Background="#61718D" Click="RefreshArchive_Click"/><Button Content="MODIFICA" Background="#F0A52B" Click="EditRepair_Click"/><Button Content="ELIMINA" Background="#E34F64" Click="DeleteRepair_Click"/><Button Content="SOLO QR" Background="#403EC2" Click="GenerateQrOnly_Click"/><Button Content="SCHEDA + QR" Click="RegeneratePdf_Click"/></WrapPanel></Grid>
        </Grid>
      </TabItem>

      <TabItem Header="MANUALI TECNICI">
        <Grid Margin="8,16"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <GroupBox Header="Carica manuale o fotografia" Margin="0,0,18,0"><StackPanel><TextBlock Text="Marca *"/><ComboBox x:Name="ManualBrandBox" IsEditable="True" SelectionChanged="ManualBrandBox_SelectionChanged"/><TextBlock Text="Modello *"/><ComboBox x:Name="ManualModelBox" IsEditable="True"/><TextBlock Text="Titolo / descrizione *"/><TextBox x:Name="ManualTitleBox"/><TextBlock Text="File selezionato"/><TextBox x:Name="ManualFileBox" IsReadOnly="True"/><Button Content="SCEGLI PDF, FOTO O DOCUMENTO" Click="ChooseManualFile_Click"/><Button Content="SALVA NELL'ARCHIVIO OFFLINE" Background="#138A72" Click="SaveManual_Click"/></StackPanel></GroupBox>
          <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="FILTRA" Click="RefreshManuals_Click"/><ComboBox x:Name="ManualFilterBrandBox" Width="210" IsEditable="True" SelectionChanged="ManualFilterBrandBox_SelectionChanged"/><ComboBox x:Name="ManualFilterModelBox" Width="230" IsEditable="True"/></DockPanel><DataGrid Grid.Row="1" x:Name="ManualsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10" MouseDoubleClick="ManualsGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Marca" Binding="{Binding Brand}" Width="150"/><DataGridTextColumn Header="Modello" Binding="{Binding Model}" Width="180"/><DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="220"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="APRI" Click="OpenManual_Click"/><Button Content="ELIMINA" Background="#C43E4D" Click="DeleteManual_Click"/></StackPanel></Grid>
        </Grid>
      </TabItem>

      <TabItem Header="CALENDARIO">
        <Grid Margin="8,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <GroupBox Header="Seleziona una data" Margin="0,0,18,0">
            <Calendar x:Name="AppointmentsCalendar" SelectionMode="SingleDate" SelectedDatesChanged="AppointmentsCalendar_SelectedDatesChanged" HorizontalAlignment="Stretch" VerticalAlignment="Top" FontSize="16"/>
          </GroupBox>
          <GroupBox Grid.Column="1" Header="Riparazioni programmate">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="SelectedDayTitle" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Primary}" Margin="4,4,4,14"/>
              <ListBox Grid.Row="1" x:Name="AppointmentsList" MouseDoubleClick="AppointmentsList_MouseDoubleClick" FontSize="15" Background="#F8FAFD" BorderBrush="#E1E6F0">
                <ListBox.ItemTemplate><DataTemplate><Border Padding="14" Margin="4" Background="White" BorderBrush="#DDE3EE" BorderThickness="1"><StackPanel><TextBlock Text="{Binding CalendarText}" FontWeight="SemiBold"/><TextBlock Text="{Binding RepairDescription}" Foreground="#667085" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="2" Text="Doppio clic su una prenotazione per modificarne data o ora." Foreground="#667085" Margin="4,12,4,4"/>
            </Grid>
          </GroupBox>
        </Grid>
      </TabItem>

      <TabItem Header="CATALOGO TELEFONI">
        <Grid Margin="8,16" MaxWidth="900" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
          <GroupBox Header="Aggiungi una marca" Margin="0,0,18,0"><StackPanel><TextBlock Text="Nome marca"/><TextBox x:Name="NewBrandBox"/><Button Content="AGGIUNGI MARCA" Click="AddBrand_Click"/></StackPanel></GroupBox>
          <GroupBox Grid.Column="1" Header="Aggiungi un modello"><StackPanel><TextBlock Text="Marca"/><ComboBox x:Name="CatalogBrandBox" IsEditable="True"/><TextBlock Text="Nome modello"/><TextBox x:Name="NewModelBox"/><Button Content="AGGIUNGI MODELLO" Click="AddModel_Click"/></StackPanel></GroupBox>
        </Grid>
      </TabItem>

      <TabItem Header="IMPOSTAZIONI">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><StackPanel Margin="8,16" MaxWidth="1040" HorizontalAlignment="Stretch">
          <GroupBox Header="Dati che compariranno nel PDF">
            <StackPanel>
              <TextBlock Text="Nome negozio / centro assistenza"/><TextBox x:Name="ShopNameBox"/>
              <TextBlock Text="Indirizzo"/><TextBox x:Name="ShopAddressBox"/>
              <TextBlock Text="Telefono"/><TextBox x:Name="ShopPhoneBox"/>
              <TextBlock Text="Email"/><TextBox x:Name="ShopEmailBox"/>
              <TextBlock Text="Partita IVA"/><TextBox x:Name="ShopVatBox"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Dove salvare archivio e PDF">
            <StackPanel>
              <TextBlock Text="Modalità di archiviazione" FontWeight="SemiBold"/>
              <ComboBox x:Name="StorageModeBox" SelectionChanged="StorageModeBox_SelectionChanged">
                <ComboBoxItem Content="PC — dati salvati su questo computer" Tag="PC"/>
                <ComboBoxItem Content="PORTATILE — dati e PDF accanto al programma / sulla chiavetta" Tag="Portable"/>
              </ComboBox>
              <TextBlock Text="Cartella PDF personalizzata (facoltativa)" FontWeight="SemiBold"/>
              <DockPanel><Button DockPanel.Dock="Right" Content="SCEGLI CARTELLA" Click="ChoosePdfFolder_Click"/><TextBox x:Name="PdfFolderBox" IsReadOnly="True"/></DockPanel>
              <Button Content="USA CARTELLA PREDEFINITA" Background="#6D7588" HorizontalAlignment="Left" Click="DefaultPdfFolder_Click"/>
              <Border Background="#EEF1FF" Padding="12" Margin="0,12,0,5"><TextBlock x:Name="StoragePreviewText" TextWrapping="Wrap" Foreground="#4145C8"/></Border>
            </StackPanel>
          </GroupBox>
