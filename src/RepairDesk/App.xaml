<Application x:Class="RepairDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Primary" Color="#1267E8"/>
    <SolidColorBrush x:Key="PrimaryDark" Color="#0849AC"/>
    <SolidColorBrush x:Key="Accent" Color="#F5B82E"/>
    <SolidColorBrush x:Key="PageBg" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="Text" Color="#14213A"/>
    <SolidColorBrush x:Key="MutedText" Color="#65728A"/>
    <LinearGradientBrush x:Key="MainGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E7F3FF" Offset="0"/><GradientStop Color="#F7FAFF" Offset="0.48"/><GradientStop Color="#FFF8DF" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#071A3D" Offset="0"/><GradientStop Color="#0E4EA7" Offset="0.62"/><GradientStop Color="#147CE5" Offset="1"/></LinearGradientBrush>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#18FFFFFF"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="15,12"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="CaretBrush" Value="{StaticResource Primary}"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,5,12,10"/><Setter Property="BorderBrush" Value="#B9CAE4"/><Setter Property="Background" Value="#EFFFFFFF"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,5,12,10"/><Setter Property="BorderBrush" Value="#B9CAE4"/><Setter Property="Background" Value="#F7FFFFFF"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,6,18,6"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,17"/><Setter Property="Padding" Value="17"/><Setter Property="Background" Value="#D9FFFFFF"/><Setter Property="BorderBrush" Value="#9BB9E0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#334866"/><Setter Property="Background" Value="#C9FFFFFF"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="2,0,2,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SideNavigationTabs" TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Border Background="Transparent"><ContentPresenter ContentSource="SelectedContent"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#EFFFFFFF"/><Setter Property="RowBackground" Value="#EFFFFFFF"/><Setter Property="AlternatingRowBackground" Value="#DCEBFAFF"/><Setter Property="RowHeight" Value="44"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#D7E2F0"/><Setter Property="BorderBrush" Value="#AFC6E4"/></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
  </Application.Resources>
</Application>
